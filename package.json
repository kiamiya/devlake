{
  "name": "devlake",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AgentLake : du brief au plan validé, réalisé par des agents Claude Code dans GitHub Actions",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json && npm run build:app -w desktop",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json && npm run typecheck --workspaces",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:live": "vitest run -c vitest.live.config.ts",
    "test:e2e": "npm run test:e2e -w desktop",
    "depcruise": "depcruise packages/*/src --config .dependency-cruiser.cjs",
    "clean": "tsc -b tsconfig.build.json --clean",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
