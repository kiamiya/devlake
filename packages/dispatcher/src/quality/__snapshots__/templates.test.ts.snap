exports[`gabarits qualité > unity : déclencheurs, permissions minimales, actions épinglées, rien de non bloquant 1`] = `
"# Gabarit AgentLake, profil qualité « unity » : CI du projet, posée par la tâche bootstrap.
# Les noms de jobs sont des checks obligatoires de la protection de main : ne pas les renommer.
# Adapter les commandes à la stack réelle du projet ; un job ne doit jamais être vidé ou sauté.
name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

concurrency:
  group: ci-\${{ github.ref }}
  cancel-in-progress: \${{ github.event_name == 'pull_request' }}

jobs:
  lint:
    name: lint
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
        with:
          lfs: true
      - name: lint
        run: bash scripts/ci/lint.sh
  typecheck:
    name: typecheck
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@v4
        with:
          lfs: true
      - uses: actions/cache@v4
        with:
          path: Library
          key: Library-\${{ hashFiles('Assets/**', 'Packages/**', 'ProjectSettings/**') }}
          restore-keys: Library-
      - uses: game-ci/unity-test-runner@v4
        env:
          UNITY_LICENSE: \${{ secrets.UNITY_LICENSE }}
          UNITY_EMAIL: \${{ secrets.UNITY_EMAIL }}
          UNITY_PASSWORD: \${{ secrets.UNITY_PASSWORD }}
        with:
          testMode: editmode
          customParameters: -testCategory "Compilation"
          coverageOptions: generateAdditionalMetrics;generateHtmlReport;assemblyFilters:+Game*
  unit-tests:
    name: unit-tests
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4
        with:
          lfs: true
      - uses: actions/cache@v4
        with:
          path: Library
          key: Library-\${{ hashFiles('Assets/**', 'Packages/**', 'ProjectSettings/**') }}
          restore-keys: Library-
      - uses: game-ci/unity-test-runner@v4
        env:
          UNITY_LICENSE: \${{ secrets.UNITY_LICENSE }}
          UNITY_EMAIL: \${{ secrets.UNITY_EMAIL }}
          UNITY_PASSWORD: \${{ secrets.UNITY_PASSWORD }}
        with:
          testMode: editmode
          coverageOptions: generateAdditionalMetrics;generateHtmlReport;assemblyFilters:+Game*
  integration-tests:
    name: integration-tests
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4
        with:
          lfs: true
      - uses: actions/cache@v4
        with:
          path: Library
          key: Library-\${{ hashFiles('Assets/**', 'Packages/**', 'ProjectSettings/**') }}
          restore-keys: Library-
      - uses: game-ci/unity-test-runner@v4
        env:
          UNITY_LICENSE: \${{ secrets.UNITY_LICENSE }}
          UNITY_EMAIL: \${{ secrets.UNITY_EMAIL }}
          UNITY_PASSWORD: \${{ secrets.UNITY_PASSWORD }}
        with:
          testMode: playmode
          customParameters: -testCategory "Integration"
          coverageOptions: generateAdditionalMetrics;generateHtmlReport;assemblyFilters:+Game*
  playmode-tests:
    name: playmode-tests
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4
        with:
          lfs: true
      - uses: actions/cache@v4
        with:
          path: Library
          key: Library-\${{ hashFiles('Assets/**', 'Packages/**', 'ProjectSettings/**') }}
          restore-keys: Library-
      - uses: game-ci/unity-test-runner@v4
        env:
          UNITY_LICENSE: \${{ secrets.UNITY_LICENSE }}
          UNITY_EMAIL: \${{ secrets.UNITY_EMAIL }}
          UNITY_PASSWORD: \${{ secrets.UNITY_PASSWORD }}
        with:
          testMode: playmode
          coverageOptions: generateAdditionalMetrics;generateHtmlReport;assemblyFilters:+Game*
  build:
    name: build
    runs-on: ubuntu-latest
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@v4
        with:
          lfs: true
      - uses: game-ci/unity-builder@v4
        env:
          UNITY_LICENSE: \${{ secrets.UNITY_LICENSE }}
          UNITY_EMAIL: \${{ secrets.UNITY_EMAIL }}
          UNITY_PASSWORD: \${{ secrets.UNITY_PASSWORD }}
        with:
          targetPlatform: StandaloneLinux64
  dependency-audit:
    name: dependency-audit
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
        with:
          lfs: true
      - name: dependency-audit
        run: bash scripts/ci/dependency-audit.sh
  gitleaks:
    name: gitleaks
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Détection de secrets
        run: docker run --rm -v "$PWD:/repo" zricethezav/gitleaks:v8.24.3 detect --source /repo --redact --verbose
  codeql:
    name: codeql
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
      security-events: write
    steps:
      - uses: actions/checkout@v4
      - uses: github/codeql-action/init@v3
        with:
          languages: csharp
          build-mode: none
      - uses: github/codeql-action/analyze@v3
"
`;

exports[`gabarits qualité > unreal : déclencheurs, permissions minimales, actions épinglées, rien de non bloquant 1`] = `
"# Gabarit AgentLake, profil qualité « unreal » : CI du projet, posée par la tâche bootstrap.
# Les noms de jobs sont des checks obligatoires de la protection de main : ne pas les renommer.
# Adapter les commandes à la stack réelle du projet ; un job ne doit jamais être vidé ou sauté.
name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

concurrency:
  group: ci-\${{ github.ref }}
  cancel-in-progress: \${{ github.event_name == 'pull_request' }}

jobs:
  lint:
    name: lint
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
        with:
          lfs: true
      - name: lint
        run: bash scripts/ci/lint.sh
  typecheck:
    name: typecheck
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4
        with:
          lfs: true
      - name: typecheck
        run: bash scripts/ci/typecheck.sh
  unit-tests:
    name: unit-tests
    runs-on: ubuntu-latest
    timeout-minutes: 120
    env:
      RUNTIME: .agentlake-runtime
    steps:
      - name: Scripts AgentLake
        uses: actions/checkout@v4
        with:
          repository: kiamiya/devlake
          ref: v1
          path: .agentlake-runtime
          persist-credentials: false
      - uses: actions/setup-node@v4
        with:
          node-version: 24
      - name: Installer et compiler les scripts
        working-directory: .agentlake-runtime
        env:
          ELECTRON_SKIP_BINARY_DOWNLOAD: '1'
        run: |
          npm ci --ignore-scripts --no-audit --no-fund
          npx tsc -b tsconfig.build.json
      # Tests d'automatisation sur l'éditeur du poste, via le pont Aura (UnrealEditor-Cmd sur le
      # clone dédié, au commit exact de la PR) ; l'éditeur occupé fait patienter le job.
      - name: unit-tests
        env:
          AURA_BRIDGE_URL: \${{ vars.AURA_BRIDGE_URL }}
          AURA_BRIDGE_SECRET: \${{ secrets.AURA_BRIDGE_SECRET }}
          BRANCH: \${{ github.head_ref || github.ref_name }}
          SHA: \${{ github.event.pull_request.head.sha || github.sha }}
          # Filtre « Automation RunTests » : à adapter au nom des tests du projet.
          AUTOMATION_FILTER: Project.Unit
          WAIT_MINUTES: '110'
        run: node "$RUNTIME/packages/dispatcher/dist/quality/editor-ci.js"
  integration-tests:
    name: integration-tests
    runs-on: ubuntu-latest
    timeout-minutes: 150
    env:
      RUNTIME: .agentlake-runtime
    steps:
      - name: Scripts AgentLake
        uses: actions/checkout@v4
        with:
          repository: kiamiya/devlake
          ref: v1
          path: .agentlake-runtime
          persist-credentials: false
      - uses: actions/setup-node@v4
        with:
          node-version: 24
      - name: Installer et compiler les scripts
        working-directory: .agentlake-runtime
        env:
          ELECTRON_SKIP_BINARY_DOWNLOAD: '1'
        run: |
          npm ci --ignore-scripts --no-audit --no-fund
          npx tsc -b tsconfig.build.json
      # Tests d'automatisation sur l'éditeur du poste, via le pont Aura (UnrealEditor-Cmd sur le
      # clone dédié, au commit exact de la PR) ; l'éditeur occupé fait patienter le job.
      - name: integration-tests
        env:
          AURA_BRIDGE_URL: \${{ vars.AURA_BRIDGE_URL }}
          AURA_BRIDGE_SECRET: \${{ secrets.AURA_BRIDGE_SECRET }}
          BRANCH: \${{ github.head_ref || github.ref_name }}
          SHA: \${{ github.event.pull_request.head.sha || github.sha }}
          # Filtre « Automation RunTests » : à adapter au nom des tests du projet.
          AUTOMATION_FILTER: Project.Integration
          WAIT_MINUTES: '140'
        run: node "$RUNTIME/packages/dispatcher/dist/quality/editor-ci.js"
  build:
    name: build
    runs-on: ubuntu-latest
    timeout-minutes: 120
    steps:
      - uses: actions/checkout@v4
        with:
          lfs: true
      - name: build
        run: bash scripts/ci/build.sh
  dependency-audit:
    name: dependency-audit
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
        with:
          lfs: true
      - name: dependency-audit
        run: bash scripts/ci/dependency-audit.sh
  gitleaks:
    name: gitleaks
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Détection de secrets
        run: docker run --rm -v "$PWD:/repo" zricethezav/gitleaks:v8.24.3 detect --source /repo --redact --verbose
  codeql:
    name: codeql
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
      security-events: write
    steps:
      - uses: actions/checkout@v4
      - uses: github/codeql-action/init@v3
        with:
          languages: c-cpp
          build-mode: none
      - uses: github/codeql-action/analyze@v3
"
`;

exports[`gabarits qualité > web : déclencheurs, permissions minimales, actions épinglées, rien de non bloquant 1`] = `
"# Gabarit AgentLake, profil qualité « web » : CI du projet, posée par la tâche bootstrap.
# Les noms de jobs sont des checks obligatoires de la protection de main : ne pas les renommer.
# Adapter les commandes à la stack réelle du projet ; un job ne doit jamais être vidé ou sauté.
name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

concurrency:
  group: ci-\${{ github.ref }}
  cancel-in-progress: \${{ github.event_name == 'pull_request' }}

jobs:
  lint:
    name: lint
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm
      - run: npm ci
      - run: npm run lint
  typecheck:
    name: typecheck
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm
      - run: npm ci
      - run: npm run typecheck
  unit-tests:
    name: unit-tests
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm
      - run: npm ci
      - run: npm run test:unit -- --coverage
  integration-tests:
    name: integration-tests
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm
      - run: npm ci
      - uses: supabase/setup-cli@v1
        with:
          version: latest
      - name: Supabase local (base de test, RLS testée par pgTAP)
        run: supabase start && supabase test db
      - run: npm run test:integration
  build:
    name: build
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm
      - run: npm ci
      - run: npm run build
  dependency-audit:
    name: dependency-audit
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm
      - run: npm ci
      - run: npm audit --audit-level=high --omit=dev
  gitleaks:
    name: gitleaks
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Détection de secrets
        run: docker run --rm -v "$PWD:/repo" zricethezav/gitleaks:v8.24.3 detect --source /repo --redact --verbose
  e2e:
    name: e2e
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm
      - run: npm ci
      - run: npx playwright install --with-deps
      - run: npm run test:e2e
  codeql:
    name: codeql
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
      security-events: write
    steps:
      - uses: actions/checkout@v4
      - uses: github/codeql-action/init@v3
        with:
          languages: javascript-typescript
          build-mode: none
      - uses: github/codeql-action/analyze@v3
"
`;
