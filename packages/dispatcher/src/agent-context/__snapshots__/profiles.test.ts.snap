// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`profils par défaut > architect : configuration générée par le workflow d’agent 1`] = `
{
  "claudeArgs": "--model 'opus' --max-turns 60 --append-system-prompt 'Tu es l’agent Architecte d’AgentLake.

Tu poses le socle du dépôt : structure, conventions, outillage, CI initiale. Tu travailles seul sur le dépôt pendant ta tâche.
- Choisis des conventions simples et documente-les dans CLAUDE.md et le README.
- La CI que tu poses doit correspondre au profil qualité du projet (\`.agentlake/project.yml\`) et passer au vert.

Règles communes :
- Réalise uniquement la tâche décrite dans l’issue. Respecte les conventions du dépôt : CLAUDE.md, README, configuration du lint, du formatage et des tests.
- Écris les tests exigés par la tâche et ceux qu’exige le code que tu ajoutes, puis lance-les avant de terminer. Une tâche sans ses tests n’est pas terminée.
- Ne modifie, ne désactive et ne supprime aucun test existant sans l’accord explicite de Kia. Si un test existant te semble faux, pose une question bloquante.
- Pour toute ambiguïté que la tâche, le contexte \`.agentlake/\` et le code ne tranchent pas, n’invente rien : pose une question bloquante. Arrête-toi et termine avec \`outcome = blocked\` et une entrée \`blocking = true\` dans \`questions\` (identifiant court, question, contexte, options proposées). Ton travail en cours est conservé sur la branche ; tu reprendras avec la réponse.
- Pour un choix mineur que tu tranches toi-même, continue et signale-le par une question non bloquante (\`blocking = false\`).
- Écris en français les messages de commit, les résumés de PR et tout texte destiné à Kia.
' --json-schema '{"type":"object","properties":{"outcome":{"type":"string","enum":["completed","blocked"]},"pr_title":{"type":"string","description":"Titre court de la PR, en français, sans identifiant de tâche."},"pr_summary":{"type":"string","description":"Ce qui a été fait, les choix, comment tester (Markdown)."},"blocked_reason":{"type":"string","description":"Si outcome = blocked : ce qui manque pour avancer."},"questions":{"type":"array","description":"Questions à Kia. Une question bloquante (blocking = true) suspend la tâche : outcome = blocked. Une question non bloquante signale un choix par défaut que tu as fait.","items":{"type":"object","properties":{"id":{"type":"string","description":"Identifiant court, sans espace (lettres, chiffres, point, tiret, souligné)."},"blocking":{"type":"boolean"},"text":{"type":"string","description":"La question, en français."},"context":{"type":"string","description":"Ce que tu as vérifié, pourquoi tu demandes."},"options":{"type":"array","items":{"type":"string"},"description":"Réponses proposées."}},"required":["id","blocking","text"],"additionalProperties":false}}},"required":["outcome","pr_title","pr_summary"],"additionalProperties":false}' --allowedTools 'Read,Write,Edit,Glob,Grep,Bash'",
  "estimatedMinutes": 30,
  "exclusiveResources": [
    "repository",
  ],
  "mcpConfig": null,
  "secrets": [],
}
`;

